{
  "name": "mc-storage-manager-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "10.12.1"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "preinstall": "node ./scripts/verify-toolchain.mjs",
    "install": "node ./scripts/install.mjs",
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt build",
    "start": "node ./scripts/start.mjs",
    "container:start": "node ./scripts/container-start.mjs",
    "db:migrate": "node ./scripts/migrate.mjs",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:backup": "node ./scripts/backup.mjs",
    "db:restore": "node ./scripts/restore.mjs",
    "server:admin": "node ./scripts/server-admin.mjs",
    "test": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.0",
    "better-sqlite3": "12.10.0",
    "drizzle-orm": "0.44.2",
    "h3": "1.15.11",
    "nuxt": "4.5.2",
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.129",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.4",
    "esbuild": "0.28.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "vue-tsc": "3.3.11"
  }
}
