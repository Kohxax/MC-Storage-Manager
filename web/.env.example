# SQLite path. Relative paths are resolved from the web project root.
DATABASE_URL=./data/storage.db

# Nitro can be overridden for production, but local development defaults to these values.
HOST=127.0.0.1
PORT=3000

# Set true when the public endpoint is HTTPS. Keep false only for local HTTP development.
COOKIE_SECURE=false

# Only enable behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY_HEADERS=false
